VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE=your-supabase-publishable-value
VITE_WHATSAPP_PHONE=

# Optional, server-side/local seed only. Never expose this in Vite client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alternative to service role for local seed scripts.
SUPABASE_SEED_EMAIL=admin@example.com
SUPABASE_SEED_PASSWORD=your-admin-password

# Supabase Edge Function secrets for booking request emails.
# Configure these with: supabase secrets set RESEND_API_KEY=... BOOKING_EMAIL_FROM="wearevents <reservations@your-domain.fr>" PUBLIC_SITE_URL=https://www.wearevents.fr
RESEND_API_KEY=your-resend-api-key
BOOKING_EMAIL_FROM="wearevents <reservations@your-domain.fr>"
PUBLIC_SITE_URL=https://www.wearevents.fr
