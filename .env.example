VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE=your-supabase-publishable-value
VITE_SITE_URL=https://www.wearevents.fr
VITE_WHATSAPP_PHONE=
VITE_INSTAGRAM_URL=https://www.instagram.com/wearevents.fr/
VITE_TIKTOK_URL=https://www.tiktok.com/@wearevents.fr
VITE_LINKEDIN_URL=https://www.linkedin.com/company/wearevents/

# Google Analytics 4 and Google Ads.
# GA4 example: G-XXXXXXXXXX. Google Ads example: AW-XXXXXXXXXX.
# In Google Ads, enable enhanced conversions on the booking/referral conversion actions.
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
VITE_GOOGLE_ADS_REFERRAL_CONVERSION_LABEL=
VITE_GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=

# Optional, server-side/local seed only. Never expose this in Vite client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Alternative to service role for local seed scripts.
SUPABASE_SEED_EMAIL=admin@example.com
SUPABASE_SEED_PASSWORD=your-admin-password

# Supabase Edge Function secrets for booking request emails.
# Configure these with: supabase secrets set RESEND_API_KEY=... BOOKING_EMAIL_FROM="wearevents <reservations@your-domain.fr>" PUBLIC_SITE_URL=https://www.wearevents.fr
RESEND_API_KEY=your-resend-api-key
BOOKING_EMAIL_FROM="wearevents <reservations@your-domain.fr>"
PUBLIC_SITE_URL=https://www.wearevents.fr

# Server-side only. Required for /api/import-venue-ai.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
