{
  "redirects": [
    {
      "source": "/location-salle-20-personnes-paris",
      "destination": "/location-salle-20-50-personnes-paris",
      "permanent": true
    },
    {
      "source": "/location-salle-50-personnes-paris",
      "destination": "/location-salle-20-50-personnes-paris",
      "permanent": true
    },
    {
      "source": "/location-salle-100-personnes-paris",
      "destination": "/location-salle-50-100-personnes-paris",
      "permanent": true
    },
    {
      "source": "/location-salle-150-personnes-paris",
      "destination": "/location-salle-100-150-personnes-paris",
      "permanent": true
    },
    {
      "source": "/location-salle-200-personnes-paris",
      "destination": "/location-salle-150-200-personnes-paris",
      "permanent": true
    },
    {
      "source": "/location-salle-500-personnes-paris",
      "destination": "/location-salle-200-500-personnes-paris",
      "permanent": true
    },
    {
      "source": "/rooftop-paris",
      "destination": "/restaurant-privatisable-paris",
      "permanent": true
    },
    {
      "source": "/rooftop-evenement-paris",
      "destination": "/terrasse-evenement-paris",
      "permanent": true
    },
    {
      "source": "/salle-ambiance-club-paris",
      "destination": "/salle-ambiance-festive-paris",
      "permanent": true
    }
  ],
  "functions": {
    "api/seo-render.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/seo-render?path=/"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/api/seo-render?path=/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
